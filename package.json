{
  "name": "foundation-pwa",
  "version": "1.0.0",
  "description": "Foundation PWA with React Native Web and Django",
  "scripts": {
    "install:backend": "pip install -r requirements.txt",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "start:backend": "cd backend && python manage.py runserver",
    "start:frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "test:backend": "cd backend && python manage.py test",
    "test:frontend": "cd frontend && npm test",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "react-native",
    "django",
    "pwa",
    "foundation"
  ],
  "author": "Your Name",
  "license": "MIT"
} 